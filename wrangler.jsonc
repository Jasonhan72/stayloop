{
	// OpenNext trial (2026-10-18) — NOT deployed. Worker name deliberately differs
	// from the Pages project "stayloop" so a stray `wrangler deploy` cannot touch prod.
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "stayloop-opennext-trial",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "stayloop-opennext-trial"
		}
	]
}
