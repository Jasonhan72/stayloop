{
	// Production Worker (OpenNext). Built by ship2-v53.command:
	// `opennextjs-cloudflare build` → scripts/opennext-env-guard.mjs → `wrangler deploy`.
	// Traffic reaches it through the zone routes below; the old Pages project
	// "stayloop" stays untouched as the rollback target.
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "stayloop-web",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	// No workers.dev hostname: it bypasses the zone (WAF, rate rules, the http→https redirect).
	// It was only needed for the smoke run before the 2026-10-19 cutover (code review 2026-11-15, S3-19).
	"workers_dev": false,
	"preview_urls": false,
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Self-reference service binding; must match "name".
			"binding": "WORKER_SELF_REFERENCE",
			"service": "stayloop-web"
		}
	],
	"observability": { "enabled": true }
}
